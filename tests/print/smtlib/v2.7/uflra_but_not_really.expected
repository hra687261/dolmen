Warning The logic used to typecheck the problem (ALL) is not minimal. The minimal logic actually is: UFNRA
(set-info :smt-lib-version 2.6)
(set-logic UFNRA)
(declare-sort $$unsorted 0)
(declare-fun tptp.f (Real) Real)
(assert (not
         (not
          (forall ((X Real) (Y Real))
           (=> (> Y 0.0)
            (< (tptp.f X)
             (+ (* (/ 1 2) (tptp.f (+ X (- Y)))) (* (/ 1 2) (tptp.f (+ X Y)))
              (- 1.0))))))))
(check-sat)
(exit)
