(set-logic HO_UFLIA)
(declare-sort-parameter A)
(declare-const id_ (-> A A))
(declare-sort Pair 2)
(declare-sort-parameter C)
(declare-sort-parameter B)
(declare-const pair (-> B C (Pair B C)))
(define-fun b1 () Int (id_ (as id_ (-> Int Int)) 5))
(assert (forall ((x Int))
         (! (= x x)
         :pattern ((id_ (as id_ (-> Int Int)) x)))))
(assert (forall ((x (-> Int (Pair Int Int))))
         (= x (@ (as pair (-> Int Int (Pair Int Int))) 13))))
(exit)
